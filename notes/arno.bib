@article{Winter1972,
   abstract = {The 2p-lh problem of near-magic nuclei is studied within the framework of the theory of Green functions. The integral equation for the particle-particle-hole (p-p-h) response function given by Ethofer and Schuck i) is reduced to an eigenvalue problem similar to the known RPA like equations for particle-hole and particle-particle vibrations; it allows one to calculate the doorway part of the mass operator in terms of Migdal's parameters. Besides restriction of the p-p-h irreducible vertex to static effective interactions, a generalization of the quasiparticle approximation plausible for the basic ground states of magic nuclei is used. Factorizations of the six-point function are discussed. A second eigenvalue problem for a direct coupled calculation of the states of lp and lh nuclei is derived, yielding energy levels, lp (Ih) and 2p-lh (2h-lp) amplitudes relative to a correlated ground state.},
   author = {J Winter},
   issue = {3},
   journal = {Nuclear Physics A},
   pages = {535-551},
   publisher = {~) North-Holland Publishin# Co},
   title = {Study of core excitations in one-particle and one-hole nuclei by means of the six-point Green function},
   volume = {194},
   year = {1972}
}

